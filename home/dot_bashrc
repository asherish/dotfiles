# Interactive shell configuration for bash (containers and Windows Git Bash).

# Source .profile for environment variables (docker exec does not run login shells).
if [[ -f "$HOME/.profile" ]]; then
    source "$HOME/.profile"
fi

# --- History ---
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth
shopt -s histappend

# --- Shell Options ---
shopt -s autocd 2>/dev/null
shopt -s cdspell 2>/dev/null
shopt -s checkwinsize
stty -ixon

# --- Aliases ---
if command -v dircolors &>/dev/null; then
    eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
if command -v bat &>/dev/null; then
    alias cat='bat'
fi
if command -v btop &>/dev/null; then
    alias htop='btop'
fi
if command -v eza &>/dev/null; then
    alias ls='eza'
fi
if command -v prek &>/dev/null; then
    alias pre-commit='prek'
fi

# --- Functions ---

# In WezTerm, route interactive `ssh` through `wezterm ssh` so remote graphics
# protocols (Kitty/Sixel, e.g. images in herdr) bypass the Windows ConPTY layer
# and render. In any other terminal, or non-interactively (scripts; scp/rsync/git
# use the real binary regardless), fall back to the normal ssh. Use `command ssh`
# to force the real binary — e.g. when you need port forwarding, which
# `wezterm ssh` does not fully honor.
ssh() {
    if [[ $- == *i* && "$TERM_PROGRAM" == "WezTerm" ]] && command -v wezterm &>/dev/null; then
        wezterm ssh "$@"
    else
        command ssh "$@"
    fi
}

# Display an image inline at high quality using the iTerm2 graphics protocol.
# On this Windows/WezTerm setup, iTerm2 (OSC) is the only protocol that survives
# the Windows ConPTY layer between Git Bash and WezTerm; sixel/kitty (DCS/APC)
# are stripped, so they cannot be used over SSH here. Large iTerm2 payloads
# (~1.8MB+) are also dropped over SSH, so oversized images are downscaled to a
# byte budget (IMG_MAXBYTES, default 1MB) with PIL before sending; images
# already within budget are sent untouched (lossless). WezTerm sizes the image
# from the raw bytes, giving correct aspect ratio and native quality (chafa
# mis-guesses cell geometry over SSH and distorts).
# - With the WezTerm CLI (local Git Bash): delegate to `wezterm imgcat`.
# Usage: img FILE
img() {
    if command -v wezterm &>/dev/null; then
        wezterm imgcat "$@"
        return
    fi
    local f="$1"
    if [[ -z "$f" || ! -f "$f" ]]; then
        echo "img: file not found: ${f:-<none>}" >&2
        return 1
    fi
    # herdr swallows iTerm2 OSC; with kitty_graphics on (config.toml [experimental])
    # and a ConPTY-free outer terminal such as `wezterm ssh`, it renders the Kitty
    # protocol instead. iTerm2 does not reach the terminal inside herdr.
    if [[ -n "${HERDR_ENV:-}" ]] && command -v chafa &>/dev/null; then
        chafa -f kitty "$f"
        return
    fi
    # tmux passthrough drops payloads well before the direct-SSH limit, so use a
    # smaller default budget inside tmux (override with IMG_MAXBYTES). Note that
    # images shown through tmux are erased on scroll/redraw (tmux is not image-aware).
    local budget="${IMG_MAXBYTES:-1000000}"
    if [[ -n "$TMUX" && -z "${IMG_MAXBYTES:-}" ]]; then
        budget=500000
    fi
    local src="$f" tmp=""
    if [[ "$(wc -c < "$f")" -gt "$budget" ]] && command -v python3 &>/dev/null; then
        tmp=$(mktemp --suffix=.jpg) || return 1
        if python3 - "$f" "$tmp" "$budget" <<'PY' 2>/dev/null
import sys, io
from PIL import Image
src, dst, budget = sys.argv[1], sys.argv[2], int(sys.argv[3])
im = Image.open(src).convert("RGB")
w, h = im.size
enc = lambda image: (lambda b: (image.save(b, "JPEG", quality=90), b.getvalue())[1])(io.BytesIO())
data, scale = enc(im), 1.0
while len(data) > budget and min(int(w * scale), int(h * scale)) > 200:
    scale *= 0.85
    data = enc(im.resize((max(1, int(w * scale)), max(1, int(h * scale)))))
open(dst, "wb").write(data)
PY
        then
            src="$tmp"
        fi
    fi
    local size
    size=$(wc -c < "$src")
    if [[ -n "$TMUX" ]]; then
        # Wrap in the tmux passthrough envelope (needs allow-passthrough on).
        printf '\033Ptmux;\033\033]1337;File=inline=1;size=%s;width=auto;preserveAspectRatio=1:' "$size"
        base64 -w0 "$src"
        printf '\a\033\\\n'
    else
        printf '\033]1337;File=inline=1;size=%s;width=auto;preserveAspectRatio=1:' "$size"
        base64 -w0 "$src"
        printf '\a\n'
    fi
    [[ -n "$tmp" ]] && rm -f "$tmp"
}

# --- External Tools ---
# Reset to avoid duplication on re-source
unset PROMPT_COMMAND
unset STARSHIP_PROMPT_COMMAND

# mise (Tool Manager)
if command -v mise &>/dev/null; then
    eval "$(mise activate bash)"
elif [[ -f "$HOME/.local/bin/mise" ]]; then
    eval "$("$HOME/.local/bin/mise" activate bash)"
fi

# zoxide (Smart cd)
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi

# direnv (Per-directory environment)
if command -v direnv &>/dev/null; then
    eval "$(direnv hook bash)"
fi

# atuin (Shell history)
if command -v atuin &>/dev/null; then
    eval "$(atuin init bash)"
fi

# starship (Prompt)
if command -v starship &>/dev/null; then
    eval "$(starship init bash)"
fi
