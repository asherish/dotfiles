# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Interactive shell configuration for zsh.

# --- History ---
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

# --- Shell Options ---
setopt AUTO_CD
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
[[ -t 0 ]] && stty -ixon

# --- Terminal Title ---
# Set tmux window name and terminal title to current directory name.
function precmd_set_title() {
    local current_dir="${PWD##*/}"
    if [[ -n "$TMUX" ]]; then
        [[ "$_tmux_prev_dir" != "$current_dir" ]] || return
        tmux rename-window "$current_dir"
        _tmux_prev_dir="$current_dir"
    else
        printf '\033]2;%s\033\\' "$current_dir"
    fi
}
precmd_functions+=(precmd_set_title)

# --- Completion ---
autoload -Uz compinit
if [[ -z ~/.zcompdump(#qNmh-24) ]]; then
    compinit
else
    compinit -C
fi

# Case-insensitive and partial-word matching (e.g., "d/kaggle" matches "Documents/kaggle")
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'

# --- Aliases ---
if [[ -x /usr/bin/dircolors ]]; then
    eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
fi
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
if command -v bat &>/dev/null; then
    alias cat='bat'
fi
if command -v btop &>/dev/null; then
    alias htop='btop'
fi
if command -v eza &>/dev/null; then
    alias ls='eza'
fi
if command -v prek &>/dev/null; then
    alias pre-commit='prek'
fi

# --- External Tools ---

# mise (Tool Manager) — must be activated before sheldon, which is installed via mise
if [[ -f "$HOME/.local/bin/mise" ]]; then
    eval "$("$HOME/.local/bin/mise" activate zsh)"
fi

# mise completions (requires `usage` CLI, installed via mise tools)
if [[ -f "$HOME/.local/bin/mise" ]] && command -v usage &>/dev/null; then
    eval "$("$HOME/.local/bin/mise" completion zsh)"
fi

# --- sheldon (Plugin Manager) ---
if command -v sheldon &>/dev/null; then
    eval "$(sheldon source)"
fi

# --- Functions ---

# Select a ghq-managed repository with fzf and open it.
# herdr: creates a new workspace rooted at the repository.
# tmux: opens the repository in the "ide" session layout.
function repo() {
    local moveto
    moveto=$({ ghq list --full-path; echo "${HOME}/.local/share/chezmoi"; } | fzf --height 40% --reverse)
    [[ -z "${moveto}" ]] && return 0
    if [[ -n "$HERDR_ENV" ]]; then
        herdr workspace create --cwd "${moveto}" --label "${moveto##*/}" --focus >/dev/null
    else
        ide "${moveto}"
    fi
}

# Launch a VS Code-like IDE layout in tmux.
# Always creates a new window in the "ide" session with 50/50 split.
# Left pane: yazi. Right pane: terminal.
# Usage: ide [directory]
function ide() {
    local dir="${1:-.}"
    dir="${dir:a}"
    [[ -d "$dir" ]] || { echo "ide: invalid directory: $1" >&2; return 1; }
    local win_name="${dir##*/}"

    if ! tmux has-session -t ide 2>/dev/null; then
        tmux new-session -d -s ide -c "$dir" -n "$win_name" \; \
             split-window -t ide -h -l 50% -c "$dir" \; \
             respawn-pane -k -t ide:.1 "zsh --no-rcs -c \"yazi; exec zsh\"" \; \
             select-pane -t ide:.1
    else
        tmux new-window -t ide -c "$dir" -n "$win_name" \; \
             split-window -t ide -h -l 50% -c "$dir" \; \
             respawn-pane -k -t ide:.1 "zsh --no-rcs -c \"yazi; exec zsh\"" \; \
             select-pane -t ide:.1
    fi

    if [[ -z "$TMUX" ]]; then
        tmux attach-session -t ide
    else
        tmux switch-client -t ide
    fi
}

# In WezTerm, route interactive `ssh` through `wezterm ssh` so remote graphics
# protocols (Kitty/Sixel, e.g. images in herdr) bypass the Windows ConPTY layer
# and render. In any other terminal, or non-interactively (scripts; scp/rsync/git
# use the real binary regardless), fall back to the normal ssh. Use `command ssh`
# to force the real binary — e.g. when you need port forwarding, which
# `wezterm ssh` does not fully honor.
function ssh() {
    if [[ $- == *i* && "$TERM_PROGRAM" == "WezTerm" ]] && command -v wezterm &>/dev/null; then
        wezterm ssh "$@"
    else
        command ssh "$@"
    fi
}

# Display an image inline at high quality using the iTerm2 graphics protocol.
# On this Windows/WezTerm setup, iTerm2 (OSC) is the only protocol that survives
# the Windows ConPTY layer between Git Bash and WezTerm; sixel/kitty (DCS/APC)
# are stripped, so they cannot be used over SSH here. Large iTerm2 payloads
# (~1.8MB+) are also dropped over SSH, so oversized images are downscaled to a
# byte budget (IMG_MAXBYTES, default 1MB) with PIL before sending; images
# already within budget are sent untouched (lossless). WezTerm sizes the image
# from the raw bytes, giving correct aspect ratio and native quality (chafa
# mis-guesses cell geometry over SSH and distorts).
# - With the WezTerm CLI (local Git Bash): delegate to `wezterm imgcat`.
# Usage: img FILE
function img() {
    if command -v wezterm &>/dev/null; then
        wezterm imgcat "$@"
        return
    fi
    local f="$1"
    if [[ -z "$f" || ! -f "$f" ]]; then
        echo "img: file not found: ${f:-<none>}" >&2
        return 1
    fi
    # herdr swallows iTerm2 OSC; with kitty_graphics on (config.toml [experimental])
    # and a ConPTY-free outer terminal such as `wezterm ssh`, it renders the Kitty
    # protocol instead. iTerm2 does not reach the terminal inside herdr.
    if [[ -n "${HERDR_ENV:-}" ]] && command -v chafa &>/dev/null; then
        chafa -f kitty "$f"
        return
    fi
    # tmux passthrough drops payloads well before the direct-SSH limit, so use a
    # smaller default budget inside tmux (override with IMG_MAXBYTES). Note that
    # images shown through tmux are erased on scroll/redraw (tmux is not image-aware).
    local budget="${IMG_MAXBYTES:-1000000}"
    if [[ -n "$TMUX" && -z "${IMG_MAXBYTES:-}" ]]; then
        budget=500000
    fi
    local src="$f" tmp=""
    if [[ "$(wc -c < "$f")" -gt "$budget" ]] && command -v python3 &>/dev/null; then
        tmp=$(mktemp --suffix=.jpg) || return 1
        if python3 - "$f" "$tmp" "$budget" <<'PY' 2>/dev/null
import sys, io
from PIL import Image
src, dst, budget = sys.argv[1], sys.argv[2], int(sys.argv[3])
im = Image.open(src).convert("RGB")
w, h = im.size
enc = lambda image: (lambda b: (image.save(b, "JPEG", quality=90), b.getvalue())[1])(io.BytesIO())
data, scale = enc(im), 1.0
while len(data) > budget and min(int(w * scale), int(h * scale)) > 200:
    scale *= 0.85
    data = enc(im.resize((max(1, int(w * scale)), max(1, int(h * scale)))))
open(dst, "wb").write(data)
PY
        then
            src="$tmp"
        fi
    fi
    local size
    size=$(wc -c < "$src")
    if [[ -n "$TMUX" ]]; then
        # Wrap in the tmux passthrough envelope (needs allow-passthrough on).
        printf '\033Ptmux;\033\033]1337;File=inline=1;size=%s;width=auto;preserveAspectRatio=1:' "$size"
        base64 -w0 "$src"
        printf '\a\033\\\n'
    else
        printf '\033]1337;File=inline=1;size=%s;width=auto;preserveAspectRatio=1:' "$size"
        base64 -w0 "$src"
        printf '\a\n'
    fi
    [[ -n "$tmp" ]] && rm -f "$tmp"
}

# zoxide (Smart cd)
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# direnv (Per-directory environment)
if command -v direnv &>/dev/null; then
    eval "$(direnv hook zsh)"
fi

# Powerlevel10k (Prompt) — loaded via sheldon, configured via ~/.p10k.zsh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Local overrides (e.g., company proxy settings)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
